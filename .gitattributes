# Keep Unity YAML assets diffable and normalize text files.
*.cs text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.uss text eol=lf
*.ps1 text eol=lf

# Binary art/media should never be line-normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.aseprite binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
